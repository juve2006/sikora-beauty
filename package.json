{
  "name": "sikora-beauty",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "DATABASE_URL=\"${DATABASE_URL_UNPOOLED:?DATABASE_URL_UNPOOLED is not set}\" NODE_ENV=production payload migrate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "graphql": "^16.14.2",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "@parcel/watcher": false,
    "@swc/core": false,
    "fsevents": false
  }
}
