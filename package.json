{
  "name": "sikora-beauty",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"${VERCEL_ENV:?VERCEL_ENV is not set}\" = production ]; then DATABASE_URL=\"${DATABASE_URL_UNPOOLED:?DATABASE_URL_UNPOOLED is not set}\" NODE_ENV=production payload migrate; fi && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed:catalog": "NODE_ENV=production payload run src/db/seed.ts",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/storage-vercel-blob": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@sentry/browser": "11.10.0",
    "@sentry/nextjs": "11.10.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "graphql": "^16.14.2",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "payload": "3.92.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "pg": "8.20.0",
    "prettier": "^3.9.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "graphql-scalars": "^2.0.1"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "@parcel/watcher": false,
    "@swc/core": false,
    "fsevents": false
  }
}
