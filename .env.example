# Copy to .env for local development. Production values live only in Vercel.

# Local: the Postgres from docker-compose.yml. Vercel: Neon's pooled connection.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sikora
# Vercel only: Neon's direct connection, used by `payload migrate` during the deploy build.
DATABASE_URL_UNPOOLED=
# 32 or more random characters: openssl rand -hex 32
PAYLOAD_SECRET=
# Vercel Blob, where product photos live. Required on Vercel; locally optional — without it photos
# go to ./media. To upload to Blob locally, paste the token from the password manager.
BLOB_READ_WRITE_TOKEN=
# «Заповнити з AI» in the admin: a key from console.anthropic.com. Optional — without it the button
# says AI is not set up.
ANTHROPIC_API_KEY=
# Orders and consultation requests to the owner's Telegram group: the bot's token from @BotFather
# and the group's chat id (negative). Optional — without them they are only stored in the admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Turnstile on the consultation form, the checkout and a shopper's account, both or neither; required on Production once the
# site password is gone. Locally Cloudflare's test keys pass every check:
# 1x00000000000000000000AA and 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Errors in Sentry, Production only (docs/deploy.md, step 15); without the DSN nothing is sent. The
# token only uploads source maps during a build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Signing in with Google, Production only: Google must know the address in advance.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The checkout's Nova Poshta search. Optional — without a key it asks Nova Poshta without one, and
# when Nova Poshta does not answer the shopper types the settlement and branch.
NOVA_POSHTA_API_KEY=
# A card paid on the site through monobank acquiring: the test token from api.monobank.ua while
# building, the seller's own once her account is live. Without it the checkout offers no card.
MONO_TOKEN=
# What the daily reconciliation of mono's invoices is called with, 16 characters or more. Vercel sends
# it by itself; required on a Production with MONO_TOKEN. Left out, the endpoint refuses everyone.
# CRON_SECRET=
# The letters of a shopper's account: all or none, and all on Production. The store's Gmail is
# smtp.gmail.com, 465, its address, an app password (not the account's own), its address again.
# Without them nothing is sent or logged; a letter's token waits in the `customers` table.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
