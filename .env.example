# Copy to .env for local development. Production values live only in Vercel.

# Local: the Postgres from docker-compose.yml. Vercel: Neon's pooled connection.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sikora
# Vercel only: Neon's direct connection, used by `payload migrate` during the deploy build.
DATABASE_URL_UNPOOLED=
# 32 or more random characters: openssl rand -hex 32
PAYLOAD_SECRET=
